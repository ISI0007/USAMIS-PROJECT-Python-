# USAMIS-Python environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://usamis:change-me@localhost:5432/usamis_dev
TEST_DATABASE_URL=postgresql+psycopg2://usamis:change-me@localhost:5432/usamis_test

# Session / security
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Grading policy defaults (configurable)
DEFAULT_GRADE_SCALE=0-100
GPA_ENABLED=false

# Seed administrator (development only; change immediately in any shared env)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=ChangeMe_Admin1!
